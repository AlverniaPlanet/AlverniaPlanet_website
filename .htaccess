# Turn off MultiViews (prevents content negotiation from stealing clean URLs)
Options -MultiViews
DirectorySlash Off

# Clean-URL support for Next "output: export" (serve exported .html files)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # QR MarsApp: /qrcodemarsapp -> wykryj system i przekieruj
  #   iOS (iPhone/iPad/iPod) -> App Store
  #   Android                -> Google Play
  #   Desktop / inne         -> homepage
  RewriteCond %{HTTP_USER_AGENT} (iPhone|iPad|iPod) [NC]
  RewriteRule ^qrcodemarsapp/?$ https://apps.apple.com/pl/app/marsapp/id6775477060?l=pl [R=302,L]
  RewriteCond %{HTTP_USER_AGENT} Android [NC]
  RewriteRule ^qrcodemarsapp/?$ https://play.google.com/store/apps/details?id=com.alverniaplanet.marsvideo [R=302,L]
  RewriteRule ^qrcodemarsapp/?$ https://www.alverniaplanet.com/ [R=302,L]

  # Serve existing files as-is
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]
  # Map clean URLs (even if a folder with assets exists) to matching exported .html
  # skip if request already has an extension
  RewriteCond %{REQUEST_URI} !\.[^/]+$
  RewriteRule ^(.+?)/?$ /$1.html [L]
  # All other requests fall through to Apache (will 404 if missing)
</IfModule>

# Custom 404 for missing pages generated by Next export
ErrorDocument 404 /404.html

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# Caching static assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType application/json "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresDefault "access plus 3 days"
</IfModule>

# Basic security headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
